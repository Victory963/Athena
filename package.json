{
  "name": "athena",
  "version": "1.0.0",
  "private": true,
  "description": "Personal defensive Dot that lives on this machine. Closed actuators, human gate, kill switch.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "check": "tsx scripts/self-check.ts",
    "bot": "electron .",
    "app": "electron .",
    "glm:install": "hf download unsloth/GLM-5.2-GGUF --include UD-IQ1_S/* --local-dir .cache/glm-5.2/gguf"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@prisma/client": "^6.7.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.2",
    "postcss": "^8.5.3",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
